# =============================================================================
# docker compose 环境变量模板
#   1. cp .env.example .env
#   2. 把下面所有 <...> 换成真实值（可参考 src/main/resources/application-prod.yaml）
#   3. docker compose up -d --build
# =============================================================================
TZ=Asia/Shanghai
APP_VERSION=1.0.0

# ---------------------------------------------------------------- MySQL -----
MYSQL_DATABASE=ai_code_db
MYSQL_USER=root_ai_code_db
# 应用连接密码
MYSQL_PASSWORD=<MySQL 业务账号密码>
# 容器内 root 密码（首次启动初始化用，务必修改）
MYSQL_ROOT_PASSWORD=<MySQL root 密码>
MYSQL_PORT=3306

# ---------------------------------------------------------------- Redis -----
REDIS_PASSWORD=<Redis 密码>
REDIS_PORT=6379

# ------------------------------------------------------------- RabbitMQ -----
# 部署构建任务队列。**只在首次启动（数据目录为空）时创建用户**，之后改这里的密码不会生效
# （要进管理台或 rabbitmqctl 改，见 DOCKER.md）。
# 5672/15672 都不发布到宿主机，backend 通过服务名 rabbitmq:5672 连接。
RABBITMQ_USER=ai_code
RABBITMQ_PASSWORD=<RabbitMQ 密码，建议 24 位随机串>
RABBITMQ_VHOST=/
# 带 -management 才有管理台；4.3 是当前发布线
RABBITMQ_IMAGE_TAG=4.3-management

# -------------------------------------------------------------- 后端服务 -----
SERVER_PORT=8123
# 端口绑定地址：127.0.0.1 = 只允许本机访问（对外统一走 nginx 的 80）
# 需要从外部直连 http://wlbc.top:8123/api 调试时改成 0.0.0.0
SERVER_BIND=127.0.0.1
# 数据库/Redis/RabbitMQ **默认不发布到宿主机**（只在编排网络内可达，见 docker-compose.yaml 里对应服务的注释）。
# 因此下面两项平时不起作用，只有临时加回 ports 映射做排查时才会用到；绑 127.0.0.1 最安全，别写 0.0.0.0
MYSQL_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
# 生产统一入口：https://wlbc.top（80 端口只做 301 跳转到 https）
#   API：      https://wlbc.top/api/...
#   部署站点： https://wlbc.top/dist/{deployKey}/
# 该地址同时用于返回给前端和后台截图，因此容器内也必须能访问到（详见 DOCKER.md）；
# 必须是 https，否则 https 页面里的封面/部署链接会变成混合内容被拦掉
CODE_DEPLOY_HOST=https://wlbc.top/dist
# 部署构建队列（RabbitMQ）：
#   WORKERS      = 每实例并发构建数（= 消费者 concurrency）。4 核机器给 3，留 1 核给 Web/AI
#   MAX_SIZE     = 队列容量（x-max-length）。注意它是**队列声明参数**，改了必须重建队列（见 DOCKER.md）
#   SYNC_PERMITS = 同步部署接口 /app/deploy 的独立额度（该接口要当场返回地址，不能排队）
#   SYNC_MAX_WAITERS / SYNC_WAIT_TIMEOUT_MS = 同步接口的有界短排队（每实例）：
#       额度占满时最多这么多个请求在等，且每个只等这么短；超出即失败并提示改用 /app/deploy/async
DEPLOY_QUEUE_WORKERS=3
DEPLOY_QUEUE_MAX_SIZE=32
DEPLOY_QUEUE_SYNC_PERMITS=1
DEPLOY_QUEUE_SYNC_MAX_WAITERS=10
DEPLOY_QUEUE_SYNC_WAIT_TIMEOUT_MS=5000
# 死信队列容量上限（x-max-length，溢出丢最老的）：防止消费端长时间失败把磁盘吃满
# 注意它是队列声明参数，改了必须重建 deploy.dlq（见 DOCKER.md 7.1）
DEPLOY_QUEUE_MAX_DEAD_LETTER_SIZE=1000
# 部署任务恢复扫描：构建期间定期续租心跳；心跳超过 DEPLOY_RECOVERY_DEPLOYING_TIMEOUT_SECONDS 没更新视为进程崩溃，
# 应用落 failed；queued 超过 DEPLOY_RECOVERY_QUEUED_TIMEOUT_SECONDS 没有进展则按原 taskId 重新入队（重复消息由 taskId 幂等挡住）
DEPLOY_RECOVERY_ENABLED=true
DEPLOY_RECOVERY_INTERVAL_SECONDS=60
DEPLOY_RECOVERY_DEPLOYING_TIMEOUT_SECONDS=300
DEPLOY_RECOVERY_QUEUED_TIMEOUT_SECONDS=900
DEPLOY_RECOVERY_HEARTBEAT_INTERVAL_SECONDS=30
DEPLOY_RECOVERY_BATCH_SIZE=50
# 队列巡检告警：等待队列积压 / 死信积压，只在"正常→告警 / 告警→恢复"时打一条日志
DEPLOY_QUEUE_MONITOR_ENABLED=true
DEPLOY_QUEUE_MONITOR_INTERVAL_SECONDS=60
DEPLOY_QUEUE_MONITOR_WAITING_THRESHOLD=24
DEPLOY_QUEUE_MONITOR_DEAD_LETTER_THRESHOLD=1
# 数据库/Redis 连接池（4核8G：可放宽，但受 MySQL max-connections=200 约束）
DB_POOL_MAX_SIZE=32
DB_POOL_MIN_IDLE=8
REDIS_POOL_MAX_ACTIVE=48
REDIS_POOL_MAX_IDLE=24
REDIS_POOL_MIN_IDLE=8
# JVM：4核8G 显式固定堆大小（不要用 MaxRAMPercentage，容器未设限时会按整机内存算，容易吃满机器）
# -Dscreenshot.max-drivers 为截图浏览器池上限：每个 Chrome 约 200~400MB 内存
JAVA_OPTS=-Xms512m -Xmx2048m -XX:MaxMetaspaceSize=384m -XX:+ExitOnOutOfMemoryError -Djava.awt.headless=true -Duser.timezone=Asia/Shanghai -Dscreenshot.max-drivers=2 -Dscreenshot.borrow-timeout-seconds=300
# npm registry：国内用 npmmirror 加速（官方源为 https://registry.npmjs.org）
NPM_REGISTRY=https://registry.npmmirror.com

# ---------------------------------------------------- 腾讯云 COS（封面） -----
COS_HOST=<https://bucket-appid.cos.<region>.myqcloud.com>
COS_REGION=<ap-guangzhou>
COS_BUCKET=<bucket-appid>
COS_SECRET_ID=<SecretId>
COS_SECRET_KEY=<SecretKey>

# ------------------------------------------------------ 阿里云百炼（AI） -----
AI_BASE_URL=<https://xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1>
AI_WORKSPACE_ID=<ws-xxxxxxxx>
AI_API_KEY=<百炼 API Key>

# ------------------------------------------------------------ 镜像/端口 -----
# nginx 对外端口：80 只做跳转，443 承载业务
# 注意：443 除了服务器本机防火墙（ufw），还要在腾讯云轻量应用服务器控制台的"防火墙"里放行
NGINX_PORT=80
NGINX_SSL_PORT=443

# 容器自定义网络（ai-code-net）的网段：刻意避开 Docker 默认可分配池 172.17.0.0/16 ~ 172.31.0.0/16，
# 也避开最常见的 /16 内网段（10.0.0.0/16、172.16.0.0/16、192.168.0.0/16）。
# 部署前在服务器上核对一下本机网段：ip -4 addr show | grep inet ；ip route | grep -v docker
# 若与 VPC 网段冲突（例如本机就是 10.201.0.x），换一个，如 10.202.0.0/24。
# 注意：改这个值必须重建网络才生效（docker compose down && docker network rm ai-code-net && docker compose up -d）
DOCKER_SUBNET=10.201.0.0/24

# 后端镜像构建方式（详见 Dockerfile 头部 / DEPLOY.md 第 5 步）：
#   runtime-from-jar = 用本地上传的 ./app.jar 打包（推荐：2核4G 服务器不跑 Maven，几分钟完成）
#   runtime          = 在服务器容器里从源码编译（需要 Maven 中央仓库，慢且吃内存）
BACKEND_BUILD_TARGET=runtime-from-jar
# 构建时 JRE 下载地址，国内可换成清华 Adoptium 镜像
# JRE_URL=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/21/jre/x64/linux/OpenJDK21U-jre_x64_linux_hotspot_21.0.5_11.tar.gz
# nginx 镜像 tag
# NGINX_IMAGE_TAG=1.27-alpine
